# GEMINI_API_KEY: Required for Gemini AI API calls if AI extensions are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies on server.ts.
SESSION_SECRET="REPLACE_WITH_32_CHAR_RANDOM_SECRET"

# RAZORPAY (Optional - Fee Collection Gateway)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# WHATSAPP CLOUD API (Optional - Meta Graph API Notifications)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# CLOUDINARY (Optional - Cloud File Storage; falls back to validated uploads if unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""

# SMTP EMAIL NOTIFICATIONS (Optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
